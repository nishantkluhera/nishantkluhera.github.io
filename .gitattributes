# Enforce LF line endings for all text files
* text=auto eol=lf

# Explicitly declare files that are text and should be normalized to LF
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf

# Denote binary files (keep them as-is)
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
